#include <bits/stdc++.h>
using namespace std;


vector<int>bfsofgraph(int V,vector<int>adj[],int src){
    
    vector<int>bfs;
    vector<bool>vis(V,0);
    queue<int>que;
    
    que.push(src);
    vis[src]=true;
    
    while(!que.empty()){
        int curr=que.front();
        que.pop();
        
        bfs.push_back(curr);
        
        for(auto v:adj[curr]){
            if(!vis[v]){
                vis[v]=true;
                que.push(v);
            }
        }
    }
    
    return bfs;

    
}

