            int curr=q.front();
            q.pop();
            bfs.push_back(curr);
            for(int x:adj[curr]){
                if(!vis[x]){
                    vis[x]=true;
                    q.push(x);
                }
            }
        }
        
      }
        
        
    }
    
    return bfs;
}




