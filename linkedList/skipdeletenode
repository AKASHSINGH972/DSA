#include <bits/stdc++.h>
using namespace std;

struct Node{
  int data;
  Node* next;
  Node(int x): data(x),next(NULL) {}
};


Node* skipdeleteNode(Node* head,int m,int n){
    if(!head||m==0) return NULL;
    
    Node* current=head;
    Node* temp;
    
    while(current){
        for(int i=1;i<m && current!=NULL ;i++){
            current=current->next;
        }
        if(current==NULL) break;
        
        temp=current->next;
        for(int i=1;i<=n && temp!=NULL;i++){
            Node* del=temp;
            temp=temp->next;
            delete del;
        }
        current->next=temp;
        current=temp;
    }
    
    return head;
}

void print(Node* head){
    Node* temp=head;
    while(temp){
        cout<<temp->data<<"->";
        temp=temp->next;
        
    }
    cout<<"NULL\n";
}


int main() {
 Node* head=new Node(1);
 Node* temp=head;
 
 for(int i=2;i<=10;i++){
     temp->next=new Node(i);
     temp=temp->next;
 }
 
 int m=2,n=3;
 head=skipdeleteNode(head,m,n);
 print(head);

}