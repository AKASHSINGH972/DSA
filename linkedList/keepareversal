#include <bits/stdc++.h>
using namespace std;

struct Node{
    int data;
    Node* next;
    Node(int val):data(val),next(NULL) {}
};

Node* reversesegement(Node* head ,int k){
    Node* prev=NULL;
    Node* curr=head;
    
    while(curr!=NULL &&k--){
        Node* newNode=curr->next;
        curr->next=prev;
        prev=curr;
        curr=newNode;
    }
    head->next=curr;
    return prev;
}

Node* keepAreversale(Node* head,int a,int b){
    if(!head||a==0||b==0)
     return head;
     
    Node* current=head;
    Node* prevtail=NULL;
    Node* newhead=head;
    
    while(current!=NULL){
        for(int i=1;i<a&&current!=NULL;i++){
            current=current->next;
        }
        if(current==NULL) break;
        
        Node* segmentstart=current->next;
        
        current->next=NULL;
        Node* reversehead=reversesegement(segmentstart,b);
        
        if(prevtail!=NULL)
        prevtail->next=reversehead;
        else
        newhead=head;
        
        prevtail=segmentstart;
        
        current=segmentstart->next;
        
    }
    return newhead;
}

void print(Node* head){
    Node* temp=head;
    
    while(temp){
        cout<<temp->data<<" ";
        temp=temp->next;
        if(temp){
            cout<<"->";
        }
    }
    
}

int main() {
   Node* head =new Node(1);
   Node* temp=head;
   
   for(int i=2;i<=10;i++){
       temp->next=new Node(i);
       temp=temp->next;
   }
   int a=2,b=3;
   head =keepAreversale(head,a,b);
   
   print (head);

}